DATABASE_URL=postgresql://user:password@localhost:5432/rapsodium
JWT_SECRET=your-secret-key-change-me
JWT_EXPIRES_IN=7d

# Base URL of the Python FastAPI recommender service (see recommender/README.md).
RECOMMENDER_URL=http://localhost:8000

# Assistant (conversational recommendation control — see docs/assistant.md).
OPENAI_API_KEY=sk-your-openai-key
# Optional: model used for the NL -> VibeProfile extraction (default: gpt-4o-mini).
ASSISTANT_MODEL=gpt-4o-mini
